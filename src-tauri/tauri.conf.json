{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TSB Macro Editor",
  "version": "0.2.5",
  "identifier": "com.cenmeow.tsbmacroeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TSB 巨屌編輯器",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4Njg0NTgxN0M4NUFFNDkKUldSSnJvVjhnVVZvcUwvVTFoVjMwVTFvODcrZUF5SWhqdDU5b0pTb0oxeWhLTndKZ1NQWDJOVGIK",
      "endpoints": [
        "https://github.com/CenMeow/Pet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
